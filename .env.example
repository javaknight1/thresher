# Thresher environment template. Copy to .env.local (gitignored) and fill in.
# Nothing is required for M0 (pure engine). All keys below arrive at M1+.

# Upstash Redis (cache + rate limiting) — M1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Supabase — M2
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Clerk — M2
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Sentry — M1
# SENTRY_DSN=

# PostHog — M1
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
