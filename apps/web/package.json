{
  "name": "@thresher/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "embed:methodology": "node scripts/embed-methodology.mjs",
    "predev": "node scripts/embed-methodology.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/embed-methodology.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/embed-methodology.mjs",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "cf-build": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build",
    "preview": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.3",
    "@opennextjs/cloudflare": "^1.19.11",
    "@thresher/engine": "workspace:*",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "lightweight-charts": "^5.2.0",
    "next": "^15.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yahoo-finance2": "^3.15.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "wrangler": "^4.99.0"
  }
}
