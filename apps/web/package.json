{
  "name": "@thresher/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "embed:methodology": "node scripts/embed-methodology.mjs",
    "predev": "node scripts/embed-methodology.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/embed-methodology.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/embed-methodology.mjs",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "cf-build": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build",
    "preview": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/embed-methodology.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.10",
    "@opennextjs/cloudflare": "^1.20.7",
    "@thresher/engine": "workspace:*",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
